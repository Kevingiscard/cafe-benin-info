# === Café Bénin — Variables d'environnement ===

# Ollama (IA locale — prioritaire)
# URL de ton instance Ollama (local ou serveur)
OLLAMA_URL=http://localhost:11434
# Modèle Ollama à utiliser
OLLAMA_MODEL=llama3.2

# Gemini (fallback si Ollama indisponible)
# Obtenir sur https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (commentaires)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

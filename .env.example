# === Café Bénin — Variables d'environnement ===

# Ollama est facultatif. Ne pas définir localhost dans Vercel :
# une fonction serveur Vercel ne peut pas joindre votre ordinateur.
OLLAMA_URL=
# Modèle Ollama à utiliser
OLLAMA_MODEL=llama3.2

# Gemini (fallback si Ollama indisponible)
# Obtenir sur https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Supabase (commentaires)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Notifications de commentaires (facultatives)
# Le compte émetteur doit être Gmail si le transport Gmail est utilisé.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_PASSWORD=your-gmail-app-password
ADMIN_EMAIL=kevingiscard93@outlook.com
